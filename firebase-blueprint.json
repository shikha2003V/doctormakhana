{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Doctor Makhana product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "weight": { "type": "string" },
        "category": { "type": "string" },
        "productType": { "type": "string" },
        "netQuantity": { "type": "string" },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isBestSeller": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "isComingSoon": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "badge": { "type": "string" },
        "description": { "type": "string" },
        "storageInstructions": { "type": "string" },
        "packageIncludes": { "type": "string" },
        "ingredients": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Doctor Makhana customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "createdAt", "customerName", "phone", "totalAmount"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Doctor Makhana product catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Doctor Makhana customer orders"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Doctor Makhana categories"
    }
  }
}
